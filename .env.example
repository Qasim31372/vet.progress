# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secret for Authentication Token Generation
JWT_SECRET=vet_learn_hub_super_secret_jwt_key_2026_xyz99

# Default Initial Teacher / Faculty Account Credentials
TEACHER_EMAIL=teacher@vetlearnhub.com
TEACHER_PASSWORD=teacher123

# Default Admin Account (Optional Compatibility)
ADMIN_EMAIL=admin@vetportal.com
ADMIN_PASSWORD=admin123

# Google Drive Cloud Sync Configuration (Optional - Local storage is used as fallback)
# Option A: Google Apps Script Web App Deployment URL (Recommended & Easiest)
GOOGLE_SCRIPT_WEB_APP_URL=https://script.google.com/macros/s/your-deployment-id/exec
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Option B: Direct Google Drive API OAuth2 (Advanced)
GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
